rName":"technical-guide/security","slug":"/technical-guide/security/security-notes","permalink":"/docs/technical-guide/security/security-notes","draft":false,"unlisted":false,"tags":[],"version":"current","frontMatter":{},"sidebar":"tutorialSidebar","previous":{"title":"Security Overview","permalink":"/docs/technical-guide/security/"}},{"id":"user-guide/overview","title":"Overview","description":"LabManager is a comprehensive laboratory management system designed to streamline the operations of medical laboratories. It provides dedicated interfaces and features for different roles within the organization, ensuring each team member has access to exactly the tools they need.","source":"@site/docs/user-guide/overview.md","sourceDirName":"user-guide","slug":"/user-guide/overview","permalink":"/docs/user-guide/overview","draft":false,"unlisted":false,"tags":[],"version":"current","sidebarPosition":1,"frontMatter":{"sidebar_position":1,"title":"Overview"},"sidebar":"tutorialSidebar","next":{"title":"System Admin Guide","permalink":"/docs/user-guide/roles/admin"}},{"id":"user-guide/roles/admin","title":"System Admin Guide","description":"As an Administrator, you have full access to configure and manage the LabManager system. This includes managing users, laboratories, prices, and system-wide settings.","source":"@site/docs/user-guide/roles/admin.md","sourceDirName":"user-guide/roles","slug":"/user-guide/roles/admin","permalink":"/docs/user-guide/roles/admin","draft":false,"unlisted":false,"tags":[],"version":"current","sidebarPosition":1,"frontMatter":{"sidebar_position":1,"title":"System Admin Guide"},"sidebar":"tutorialSidebar","previous":{"title":"Overview","permalink":"/docs/user-guide/overview"},"next":{"title":"Chemist Guide","permalink":"/docs/user-guide/roles/chemist"}},{"id":"user-guide/roles/chemist","title":"Chemist Guide","description":"As a Chemist, your primary role in the LabManager system is to perform laboratory analysis and enter the scientific data that forms the foundation of every medical report. You handle the hands-on diagnostic work — running tests, recording results, and managing cultures and antibiotic sensitivities.","source":"@site/docs/user-guide/roles/chemist.md","sourceDirName":"user-guide/roles","slug":"/user-guide/roles/chemist","permalink":"/docs/user-guide/roles/chemist","draft":false,"unlisted":false,"tags":[],"version":"current","sidebarPosition":3,"frontMatter":{"sidebar_position":3,"title":"Chemist Guide"},"sidebar":"tutorialSidebar","previous":{"title":"System Admin Guide","permalink":"/docs/user-guide/roles/admin"},"next":{"title":"Doctor Guide","permalink":"/docs/user-guide/roles/doctor"}},{"id":"user-guide/roles/doctor","title":"Doctor Guide","description":"As a Doctor, your primary role in the LabManager system is to review, approve, and oversee medical reports. You focus on clinical interpretation and patient diagnosis, ensuring that every report released by the laboratory meets medical standards.","source":"@site/docs/user-guide/roles/doctor.md","sourceDirName":"user-guide/roles","slug":"/user-guide/roles/doctor","permalink":"/docs/user-guide/roles/doctor","draft":false,"unlisted":false,"tags":[],"version":"current","sidebarPosition":2,"frontMatter":{"sidebar_position":2,"title":"Doctor Guide"},"sidebar":"tutorialSidebar","previous":{"title":"Chemist Guide","permalink":"/docs/user-guide/roles/chemist"},"next":{"title":"Employee Guide","permalink":"/docs/user-guide/roles/employee"}},{"id":"user-guide/roles/employee","title":"Employee Guide","description":"As an Employee, you have basic access to the LabManager system. The Employee role is a general-purpose role that provides access to core system features without the specialized permissions granted to Administrators, Chemists, Doctors, or Receptionists.","source":"@site/docs/user-guide/roles/employee.md","sourceDirName":"user-guide/roles","slug":"/user-guide/roles/employee","permalink":"/docs/user-guide/roles/employee","draft":false,"unlis