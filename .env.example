# Domain & Support Configuration
DOMAIN_NAME=your-new-domain.com
SUPPORT_EMAIL=techsupport@your-new-domain.com
VITE_APP_DOMAIN=your-new-domain.com
VITE_SUPPORT_EMAIL=techsupport@your-new-domain.com

# ==========================================
# BACKEND SECRETS (Docker / Node.js)
# ==========================================

# Database Configuration
DB_USER=change_me
DB_PASSWORD=change_me
DB_NAME=labmanager
DB_HOST=mysql
DATABASE_URL=mysql://root:change_me@mysql:3306/labmanager
# Redis Configuration
REDIS_HOST=redis

# JWT Configuration
SECRET_KEY=your_generated_secret_key_here

# Email Configuration
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM=noreply@mail.curasystem.online

# Application Configuration
NODE_ENV=development
PORT=3001

PROD_CLIENT_URL=your-new-domain.com
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:3001

# MySQL Configuration (duplicate for docker compatibility)
MYSQL_ROOT_PASSWORD=change_me
MYSQL_DATABASE=labmanager_dev
MYSQL_USER=change_me
MYSQL_PASSWORD=change_me

# External APIs
GROQ_API_KEY=your_groq_api_key

# Paymob Payment Gateway Configuration
DEVELOPMENT_PAYMOB_API_KEY=your_developement_paymob_key
DEVELOPMENT_PAYMOB_SECRET_KEY=your_developement_paymob_secretkey
DEVELOPMENT_PAYMOB_INTEGRATION_ID=your_paymob_integrationId
DEVELOPMENT_PAYMOB_PUBLIC_KEY=your_paymob_publickey

# AWS Configuration (Used by Bedrock)
BEDROCK_AWS_ACCESS_KEY_ID=your_aws_access_key
BEDROCK_AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=your_region

# Object Storage Configuration (Local MinIO)
MINIO_ROOT_USER=local_minio_admin
MINIO_ROOT_PASSWORD=local_minio_password
S3_ACCESS_KEY=local_minio_admin
S3_SECRET_KEY=local_minio_password
S3_REGION=us-east-1
S3_ENDPOINT=http://minio:9000
S3_BUCKET=cura-uploads

# ==========================================
# FRONTEND VARIABLES (Vite / React)
# ==========================================
VITE_APP_NAME=LabManager
VITE_SERVER=http://localhost:3001
VITE_API_URL=http://localhost:3001
VITE_APP_VERSION=1.1.0-beta.stable

S3_EXTERNAL_ENDPOINT=http://localhost:9000