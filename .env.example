# Root .env.example - Project-wide environment variables
# Copy this file to .env.development or .env.production as needed

# Node Environment
NODE_ENV=development

# Security
SECRET_KEY=your_jwt_secret_key_here

# Docker Compose Configuration
COMPOSE_PROJECT_NAME=labmanager

# Domain Configuration (for production)
DOMAIN=labdoctors-laboratories.com
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token_here