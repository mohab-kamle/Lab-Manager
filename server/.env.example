# JWT Secret Key - Used for authentication
SECRET_KEY=your_jwt_secret_key_here

# Database Configuration
DB_USER=root
DB_PASSWORD=your_db_password_here
DB_NAME=labmanager
DB_HOST=127.0.0.1
DATABASE_URL=mysql://root:your_db_password_here@127.0.0.1:3306/labmanager

# Email Configuration
EMAIL_USER=your_email_here
EMAIL_PASS=your_email_password_here
API_URL=your_api_url_here

# Paymob Payment Gateway Configuration
# Development Environment
DEVELOPMENT_PAYMOB_API_KEY=your_development_api_key_here
DEVELOPMENT_PAYMOB_SECRET_KEY=your_development_secret_key_here
DEVELOPMENT_PAYMOB_INTEGRATION_ID=your_development_integration_id_here
DEVELOPMENT_PAYMOB_PUBLIC_KEY=your_development_public_key_here

# Production Environment
PRODUCTION_PAYMOB_API_KEY=your_production_api_key_here
PRODUCTION_PAYMOB_SECRET_KEY=your_production_secret_key_here
PRODUCTION_PAYMOB_INTEGRATION_ID=your_production_integration_id_here
PRODUCTION_PAYMOB_PUBLIC_KEY=your_production_public_key_here

# Application URLs
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:3001