{
  "development": {
    "use_env_variable": "DATABASE_URL",
    "dialect": "mysql",
    "pool": {
      "max": 40,
      "min": 5,
      "acquire": 60000,
      "idle": 10000
    },
    "dialectOptions": {
      "connectTimeout": 60000
    }
  },
  "test": {
    "username": "root",
    "password": null,
    "database": "database_test",
    "host": "127.0.0.1",
    "dialect": "mysql",
    "pool": {
      "max": 40,
      "min": 2,
      "acquire": 30000,
      "idle": 10000
    }
  },
  "production": {
    "use_env_variable": "DATABASE_URL",
    "dialect": "mysql",
    "pool": {
      "max": 100,
      "min": 20,
      "acquire": 30000,
      "idle": 10000,
      "evict": 10000
    },
    "dialectOptions": {
      "connectTimeout": 60000
    }
  }
}
