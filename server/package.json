{
  "name": "server",
  "version": "1.0.0",
  "packageManager": "pnpm@9.1.1",
  "description": "",
  "main": "index.js",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "nodemon --legacy-watch index.js",
    "start": "nodemon index.js",
    "start:prod": "pm2 start ecosystem.config.js",
    "start:cluster": "pm2 start ecosystem.config.js --env production",
    "stop": "pm2 stop ecosystem.config.js",
    "restart": "pm2 restart ecosystem.config.js",
    "reload": "pm2 reload ecosystem.config.js",
    "delete": "pm2 delete ecosystem.config.js",
    "status": "pm2 status",
    "logs": "pm2 logs",
    "migrate": "sequelize-cli db:migrate",
    "migrate:undo": "sequelize-cli db:migrate:undo",
    "run-migrations": "node scripts/runMigrations.js",
    "db:sync": "node syncDatabase.js",
    "db:sync:force": "node syncDatabase.js force",
    "db:check": "node syncDatabase.js check",
    "db:seed:admin": "sequelize-cli db:seed:all",
    "db:seed:loinc": "node scripts/seedLoinc.js",
    "db:seed": "npm run db:seed:admin && npm run db:seed:loinc",
    "db:seed:undo": "sequelize-cli db:seed:undo:all"
  },
  "keywords": [],
  "author": "Mohab",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1037.0",
    "@aws-sdk/client-s3": "^3.1038.0",
    "@aws-sdk/s3-request-presigner": "^3.1038.0",
    "axios": "^1.15.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "commander": "^12.0.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "csv-parser": "^3.2.0",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.22.0",
    "express-rate-limit": "^7.0.0",
    "form-data": "^4.0.5",
    "helmet": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "libphonenumber-js": "^1.12.42",
    "multer": "^2.1.1",
    "multer-s3": "^3.0.1",
    "mysql2": "^3.15.3",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.5",
    "nodemon": "^3.1.9",
    "openai": "^6.34.0",
    "pm2": "^6.0.8",
    "redis": "^5.10.0",
    "sequelize": "^6.37.8",
    "socket.io": "^4.8.3"
  }
}
