{
  "name": "lab-manager-root",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "pnpm -r dev",
    "build": "pnpm -r build",
    "install:all": "pnpm install",
    "db:seed": "pnpm -C server db:seed"
  },
  "devDependencies": {
    "sequelize-cli": "^6.6.3"
  },
  "pnpm": {
    "overrides": {
      "@emotion/react": "^11.11.4"
    },
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@swc/core",
      "@whiskeysockets/baileys",
      "bcrypt",
      "core-js",
      "es5-ext",
      "esbuild",
      "libsignal-node",
      "protobufjs",
      "puppeteer",
      "sharp"
    ]
  },
  "dependencies": {
    "csv-parser": "^3.2.0",
    "dotenv": "^16.6.1"
  }
}